  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uB09C\uBBFC \uBCF4\uD638\uC640 \uAD6D\uC81C\uC0AC\uD68C\uC758 \uC5F0\uB300\uB97C
    \uB418\uC0C8\uAE30\uB294 \uC138\uACC4 \uB09C\uBBFC\uC758 \uB0A0\uC778 20\uC77C,
    \uAD6D\uACBD \uAC80\uBB38\uC18C\uC5D0\uC11C \uC785\uAD6D\uC744 \uAE30\uB2E4\uB9AC\uB358
    \uB09C\uBBFC\uB4E4\uACFC \uD604\uC7A5 \uD1B5\uC81C \uC778\uB825 \uC0AC\uC774\uC5D0
    \uB300\uADDC\uBAA8 \uCDA9\uB3CC\uC774 \uBC1C\uC0DD\uD574 \uAC80\uBB38\uC18C \uC6B4\uC601\uC774
    \uC804\uBA74 \uC911\uB2E8\uB410\uB2E4.\r\n\r\n\uAD6D\uACBD\uAD00\uB9AC\uAD6D\uC5D0
    \uB530\uB974\uBA74 \uC774\uB0A0 \uC624\uC804 \uC785\uAD6D \uC2EC\uC0AC \uACB0\uACFC\uC5D0
    \uD56D\uC758\uD558\uB358 \uC77C\uBD80 \uB300\uAE30\uC790\uAC00 \uC7AC\uC2EC\uC0AC\uB97C
    \uC694\uAD6C\uD558\uBA70 \uAC80\uBB38\uC18C \uCD9C\uC785\uAD6C\uB85C \uBAB0\uB9AC\uBA74\uC11C
    \uD604\uC7A5 \uD1B5\uC81C \uC778\uB825\uACFC \uCDA9\uB3CC\uD588\uB2E4.\r\n\r\n\uCD5C\uADFC
    \uAC80\uBB38\uC18C \uC8FC\uBCC0\uC5D0\uB294 \uC785\uAD6D\uC774 \uAC70\uBD80\uB41C
    \uB4A4\uC5D0\uB3C4 \uB3CC\uC544\uAC00\uC9C0 \uBABB\uD55C \uCC44 \uC7AC\uC2EC\uC0AC\uB97C
    \uC694\uAD6C\uD558\uBA70 \uBA38\uBB34\uB974\uB294 \uB09C\uBBFC\uC774 \uB298\uC5B4\uB09C
    \uAC83\uC73C\uB85C \uC54C\uB824\uC84C\uB2E4. \uC7A5\uAE30 \uB300\uAE30 \uC778\uC6D0\uC774
    \uC99D\uAC00\uD558\uBA74\uC11C \uC2DD\uB7C9\uACFC \uC784\uC2DC \uAC70\uCC98 \uBD80\uC871
    \uBB38\uC81C\uB3C4 \uC774\uC5B4\uC84C\uC73C\uBA70, \uB2F9\uAD6D\uC740 \uC804\uB0A0\uBD80\uD130
    \uD604\uC7A5 \uC778\uB825\uC744 \uCD94\uAC00 \uBC30\uCE58\uD558\uACE0 \uCD9C\uC785\uAD6C
    \uC77C\uBD80\uB97C \uD1B5\uC81C\uD574\uC654\uB2E4.\r\n\r\n\uC774\uB0A0 \uCDA9\uB3CC\uB85C
    \uAC80\uBB38\uC18C \uC77C\uBD80 \uC2DC\uC124\uC774 \uD30C\uC190\uB418\uBA74\uC11C
    \uB2F9\uAD6D\uC740 \uC9C1\uC6D0\uACFC \uBBFC\uC6D0\uC778\uC744 \uB300\uD53C\uC2DC\uD0A4\uACE0
    \uC9C4\uD589 \uC911\uC774\uB358 \uC785\uAD6D \uC2EC\uC0AC\uB97C \uBAA8\uB450
    \uC911\uB2E8\uD588\uB2E4. \uAC80\uBB38\uC18C \uC8FC\uBCC0 \uCD9C\uC785\uB3C4
    \uC804\uBA74 \uD1B5\uC81C\uB410\uB2E4.\r\n\r\n\uB2F9\uCD08 \uC815\uBD80\uC640
    \uB09C\uBBFC \uC9C0\uC6D0\uB2E8\uCCB4\uB294 \uC774\uB0A0 \uC138\uACC4 \uB09C\uBBFC\uC758
    \uB0A0\uC744 \uB9DE\uC544 \uCD94\uBAA8 \uD589\uC0AC\uC640 \uC9C0\uC6D0 \uCEA0\uD398\uC778\uC744
    \uC9C4\uD589\uD560 \uC608\uC815\uC774\uC5C8\uC73C\uB098, \uAD6D\uACBD \uC0C1\uD669\uC774
    \uC545\uD654\uB418\uBA74\uC11C \uC77C\uBD80 \uD589\uC0AC\uAC00 \uCDE8\uC18C\uB418\uAC70\uB098
    \uCD95\uC18C\uB410\uB2E4.\r\n\r\n\uC815\uBD80\uB294 \uCD5C\uADFC \uC785\uAD6D
    \uAC70\uBD80 \uC0AC\uB840\uC640 \uC2EC\uC0AC \uC808\uCC28 \uC804\uBC18\uC744
    \uD3EC\uD568\uD574 \uC774\uBC88 \uC0AC\uD0DC\uC758 \uACBD\uC704\uB97C \uC870\uC0AC\uD560
    \uBC29\uCE68\uC774\uB2E4.\r\n\r\n\uB09C\uBBFC \uBCF4\uD638\uB97C \uCD09\uAD6C\uD558\uB294
    \uBAA9\uC18C\uB9AC\uAC00 \uC138\uACC4 \uAC01\uC9C0\uC5D0\uC11C \uC774\uC5B4\uC9C4
    \uC774\uB0A0, \uD574\uB2F9 \uAD6D\uACBD\uC5D0\uB294 \uACB0\uAD6D \uD3D0\uC1C4
    \uC870\uCE58\uAC00 \uB0B4\uB824\uC84C\uB2E4.\r\n\r\n\uC6B4\uC601 \uC7AC\uAC1C
    \uC2DC\uC810\uC740 \uC815\uD574\uC9C0\uC9C0 \uC54A\uC558\uB2E4."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 857897c8a852dbc4795bb26e471a51f6, type: 2}
