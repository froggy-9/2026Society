  dialogueLines:
  - "\uC800\uAE30\u2026\u2026 \uC5EC\uAE30\uAC00 \uAD6D\uACBD\uC774\uC9C0\uC694?"
  - "\uC6B0\uB9AC \uC544\uB4E4\uC774 \uC5EC\uAE30\uC11C \uAE30\uB2E4\uB9AC\uB77C\uACE0
    \uD588\uB294\uB370.."
  - "\uAE08\uBC29 \uC62C\uAEBC\uC5D0\uC694."
  - "\uC5EC\uAD8C\uC740\u2026\u2026 \uC544\uB4E4\uC774 \uAC00\uC9C0\uACE0 \uC788\uC5B4\uC694."
  - "\uC544\uB2C8, \uB0B4\uAC00 \uAC00\uC9C0\uACE0 \uC788\uC5C8\uB098\u2026\u2026"
  - "\uBD84\uBA85 \uC5B4\uB518\uAC00\uC5D0 \uC788\uC5C8\uB294\uB370\u2026\u2026"
  - "\uC694\uC998\uC5D0\uB294 \uB0B4\uAC00 \uC790\uAFB8 \uAE5C\uBE61\uD574\uC11C."
  - "\uB098\uBCF4\uACE0 \uBB3C\uAC74\uC744 \uC790\uAFB8 \uC783\uC5B4\uBC84\uB9B0\uB2E4\uACE0,
    \uC911\uC694\uD55C \uAC74 \uC790\uAE30\uAC00 \uCC59\uAE34\uB2E4\uACE0 \uD588\uB294\uB370\u2026\u2026"
  - "\uC544\uB9C8 \uAE08\uBC29 \uC62C \uAC70\uC608\uC694."
  - "\uC5EC\uAE30\uC11C \uAE30\uB2E4\uB9AC\uB77C\uACE0 \uD588\uC73C\uB2C8\uAE4C\u2026\u2026"
  - "\uB098\uB97C \uB370\uB9AC\uB7EC \uC62C \uAC70\uC608\uC694."
  approvedFollowUpNews: "### \uB0A8\uBD80 \uAD6D\uACBD\uC11C \uD640\uB85C \uB0A8\uACA8\uC9C4
    \uACE0\uB839 \uB09C\uBBFC \uC787\uB530\uB77C \uBC1C\uACAC\r\n\r\n*\uAC00\uC871\uACFC
    \uBD84\uB9AC\uB41C \uACE0\uB839\uC790 \uC99D\uAC00\u2026 \uC815\uBD80, \uBCF4\uD638
    \uB300\uCC45 \uB9C8\uB828 \uCC29\uC218*\r\n\r\n\uCD5C\uADFC \uD280\uB80C \uB0A8\uBD80
    \uAD6D\uACBD \uC77C\uB300\uC5D0\uC11C \uAC00\uC871\uACFC \uB3D9\uD589\uD558\uC9C0
    \uC54A\uC740 \uCC44 \uD640\uB85C \uB0A8\uACA8\uC9C4 \uACE0\uB839 \uB09C\uBBFC\uC774
    \uC787\uB530\uB77C \uBC1C\uACAC\uB418\uACE0 \uC788\uB2E4.\r\n\r\n\uAD00\uACC4
    \uB2F9\uAD6D\uC5D0 \uB530\uB974\uBA74 \uCD5C\uADFC \uBA70\uCE60\uAC04 \uB0A8\uBD80
    \uAD6D\uACBD\uC758 \uAC80\uBB38\uC18C\uC640 \uC784\uC2DC \uB300\uAE30\uC2DC\uC124\uC5D0\uC11C
    \uBCF4\uD638\uC790 \uC5C6\uC774 \uBA38\uBB3C\uACE0 \uC788\uB358 \uACE0\uB839
    \uB09C\uBBFC \uC5EC\uB7EC \uBA85\uC774 \uBC1C\uACAC\uB410\uB2E4. \uC77C\uBD80\uB294
    \uAC00\uC871\uC758 \uC774\uB984\uC774\uB098 \uACFC\uAC70 \uAC70\uC8FC\uC9C0 \uB4F1
    \uC77C\uBD80 \uC815\uBCF4\uB9CC \uAE30\uC5B5\uD558\uACE0 \uC788\uC744 \uBFD0,
    \uD604\uC7AC \uAC00\uC871\uC758 \uC18C\uC7AC\uB098 \uC790\uC2E0\uC758 \uC774\uB3D9
    \uACBD\uB85C\uB97C \uC815\uD655\uD558\uAC8C \uC124\uBA85\uD558\uC9C0 \uBABB\uD558\uB294
    \uAC83\uC73C\uB85C \uD655\uC778\uB410\uB2E4.\r\n\r\n\uB2F9\uAD6D\uC740 \uC804\uC7C1\uACFC
    \uC7A5\uAE30\uAC04\uC758 \uD53C\uB780 \uACFC\uC815\uC5D0\uC11C \uAC00\uC871\uC774
    \uC11C\uB85C \uB2E4\uB978 \uC9C0\uC5ED\uC73C\uB85C \uC774\uB3D9\uD558\uAC70\uB098
    \uC5F0\uB77D\uC774 \uB04A\uAE30\uB294 \uC0AC\uB840\uAC00 \uB298\uC5B4\uB098\uBA74\uC11C
    \uC774 \uAC19\uC740 \uC0C1\uD669\uC774 \uBC1C\uC0DD\uD55C \uAC83\uC73C\uB85C
    \uBCF4\uACE0 \uC788\uB2E4. \uD2B9\uD788 \uAC70\uB3D9\uC774 \uBD88\uD3B8\uD558\uAC70\uB098
    \uC9C0\uC18D\uC801\uC778 \uB3CC\uBD04\uC774 \uD544\uC694\uD55C \uACE0\uB839\uC790\uC758
    \uACBD\uC6B0 \uD63C\uC790 \uC774\uB3D9\uD558\uAC70\uB098 \uC2E0\uC6D0\uC744 \uD655\uC778\uD558\uB294
    \uB370 \uC5B4\uB824\uC6C0\uC744 \uACAA\uB294 \uAC83\uC73C\uB85C \uB098\uD0C0\uB0AC\uB2E4.\r\n\r\n\uD604\uC7AC
    \uB0A8\uBD80 \uAD6D\uACBD\uC758 \uC784\uC2DC \uB300\uAE30\uC2DC\uC124\uC740 \uC774\uBBF8
    \uC218\uC6A9 \uD55C\uACC4\uB97C \uB118\uC5B4\uC120 \uC0C1\uD0DC\uB85C, \uC0C8\uB86D\uAC8C
    \uBC1C\uACAC\uB418\uB294 \uACE0\uB839 \uB09C\uBBFC\uC744 \uBCC4\uB3C4\uB85C \uBCF4\uD638\uD560
    \uC2DC\uC124\uACFC \uC778\uB825\uB3C4 \uBD80\uC871\uD55C \uC0C1\uD669\uC774\uB2E4.\r\n\r\n\uD280\uB80C
    \uB0B4\uBB34\uBD80\uB294 \uACE0\uB839 \uB09C\uBBFC\uC744 \uC704\uD55C \uC784\uC2DC
    \uBCF4\uD638\uC2DC\uC124\uC744 \uB9C8\uB828\uD558\uACE0, \uAC00\uC871\uC758 \uC18C\uC7AC\uB97C
    \uD655\uC778\uD558\uAE30 \uC704\uD55C \uAD00\uACC4 \uAE30\uAD00 \uAC04 \uC815\uBCF4
    \uACF5\uC720\uB97C \uD655\uB300\uD558\uB294 \uBC29\uC548\uC744 \uAC80\uD1A0\uD558\uACE0
    \uC788\uB2E4.\r\n\r\n\uD55C \uAD00\uACC4\uC790\uB294 \u201C\uCD5C\uADFC \uAD6D\uACBD\uC5D0
    \uB3C4\uCC29\uD558\uB294 \uACE0\uB839 \uB09C\uBBFC \uAC00\uC6B4\uB370 \uBCF4\uD638\uC790\uAC00
    \uD655\uC778\uB418\uC9C0 \uC54A\uB294 \uC0AC\uB840\uAC00 \uACC4\uC18D\uD574\uC11C
    \uBC1C\uC0DD\uD558\uACE0 \uC788\uB2E4\u201D\uBA70 \u201C\uC774\uB4E4\uC744 \uB2E8\uC21C\uD55C
    \uC785\uAD6D \uC2EC\uC0AC \uB300\uC0C1\uC774 \uC544\uB2CC \uBCC4\uB3C4\uC758
    \uBCF4\uD638\uAC00 \uD544\uC694\uD55C \uB300\uC0C1\uC73C\uB85C \uBD84\uB958\uD560
    \uD544\uC694\uAC00 \uC788\uB2E4\u201D\uACE0 \uBC1D\uD614\uB2E4.\r\n\r\n\uC804\uBB38\uAC00\uB4E4\uC740
    \uC804\uC7C1\uACFC \uD53C\uB780\uC774 \uC7A5\uAE30\uD654\uB420 \uACBD\uC6B0 \uAC00\uC871\uACFC
    \uB5A8\uC5B4\uC838 \uD640\uB85C \uAD6D\uACBD\uC744 \uCC3E\uB294 \uACE0\uB839
    \uB09C\uBBFC\uC774 \uB354\uC6B1 \uB298\uC5B4\uB0A0 \uC218 \uC788\uB2E4\uBA70,
    \uACE0\uB839 \uB09C\uBBFC \uBB38\uC81C\uAC00 \uC0C8\uB85C\uC6B4 \uC0AC\uD68C\uC801
    \uBB38\uC81C\uB85C \uB5A0\uC624\uB974\uACE0 \uC788\uB294 \uB9CC\uD07C \uC7A5\uAE30\uC801\uC778
    \uBCF4\uD638 \uB300\uCC45\uC774 \uD544\uC694\uD558\uB2E4\uACE0 \uC9C0\uC801\uD588\uB2E4."
  rejectedFollowUpNews: "### \uAD6D\uACBD \uC778\uADFC \uB5A0\uB3C4\uB294 \uACE0\uB839
    \uB09C\uBBFC \uC787\uB530\uB77C\r\n\r\n*\uAC00\uC871\uACFC \uC5F0\uB77D \uB04A\uAE34
    \uACE0\uB839\uC790 \uC99D\uAC00\u2026 \uBCF4\uD638\uC2DC\uC124 \uBD80\uC871\uC5D0
    \uB300\uCC45 \uB9C8\uB828 \uC2DC\uAE09*\r\n\r\n\uD280\uB80C \uB0A8\uBD80 \uAD6D\uACBD
    \uC778\uADFC\uC5D0\uC11C \uBCF4\uD638\uC790\uB97C \uC783\uAC70\uB098 \uAC00\uC871\uACFC
    \uC5F0\uB77D\uC774 \uB04A\uAE34 \uACE0\uB839 \uB09C\uBBFC\uB4E4\uC774 \uAC08
    \uACF3\uC744 \uCC3E\uC9C0 \uBABB\uD55C \uCC44 \uC8FC\uBCC0 \uC9C0\uC5ED\uC744
    \uB5A0\uB3C4\uB294 \uC0AC\uB840\uAC00 \uC787\uB530\uB974\uACE0 \uC788\uB2E4.\r\n\r\n\uAD00\uACC4
    \uB2F9\uAD6D\uC5D0 \uB530\uB974\uBA74 \uCD5C\uADFC \uB0A8\uBD80 \uAD6D\uACBD
    \uAC80\uBB38\uC18C \uC8FC\uBCC0\uC5D0\uC11C \uAC00\uC871\uACFC \uB3D9\uD589\uD558\uC9C0
    \uC54A\uC740 \uACE0\uB839 \uB09C\uBBFC \uC5EC\uB7EC \uBA85\uC774 \uBC1C\uACAC\uB410\uB2E4.
    \uC77C\uBD80\uB294 \uC785\uAD6D\uC5D0 \uD544\uC694\uD55C \uC11C\uB958\uB97C \uAC16\uCD94\uC9C0
    \uBABB\uD588\uAC70\uB098 \uC790\uC2E0\uC758 \uC2E0\uC6D0\uACFC \uC774\uB3D9 \uACBD\uB85C\uB97C
    \uC815\uD655\uD558\uAC8C \uC124\uBA85\uD558\uC9C0 \uBABB\uD574 \uAD6D\uACBD\uC744
    \uD1B5\uACFC\uD558\uC9C0 \uBABB\uD55C \uAC83\uC73C\uB85C \uD655\uC778\uB410\uB2E4.\r\n\r\n\uBB38\uC81C\uB294
    \uC774\uB4E4\uC774 \uAD6D\uACBD \uBC16\uC73C\uB85C \uB3CC\uC544\uAC04 \uB4A4\uC5D0\uB3C4
    \uB9C8\uB545\uD788 \uBA38\uBB3C \uACF3\uC774 \uC5C6\uB2E4\uB294 \uC810\uC774\uB2E4.
    \uAC00\uC871\uACFC \uD568\uAED8 \uD53C\uB780\uC744 \uC2DC\uC791\uD588\uC9C0\uB9CC
    \uC774\uB3D9 \uACFC\uC815\uC5D0\uC11C \uBCF4\uD638\uC790\uC640 \uB5A8\uC5B4\uC9C4
    \uACBD\uC6B0\uAC00 \uB9CE\uC544, \uC2A4\uC2A4\uB85C \uAC00\uC871\uC758 \uC18C\uC7AC\uB97C
    \uD655\uC778\uD558\uAC70\uB098 \uB2E4\uB978 \uC9C0\uC5ED\uC73C\uB85C \uC774\uB3D9\uD558\uAE30\uB3C4
    \uC5B4\uB824\uC6B4 \uC0C1\uD669\uC774\uB2E4.\r\n\r\n\uD604\uC7AC \uAD6D\uACBD
    \uC778\uADFC\uC5D0\uB294 \uC784\uC2DC \uB300\uD53C\uC2DC\uC124\uACFC \uAD6C\uD638\uC18C\uAC00
    \uC6B4\uC601\uB418\uACE0 \uC788\uC9C0\uB9CC, \uACC4\uC18D\uD574\uC11C \uC720\uC785\uB418\uB294
    \uD53C\uB780\uBBFC\uC744 \uBAA8\uB450 \uC218\uC6A9\uD558\uAE30\uC5D0\uB294 \uC2DC\uC124\uACFC
    \uC778\uB825\uC774 \uBD80\uC871\uD55C \uAC83\uC73C\uB85C \uC54C\uB824\uC84C\uB2E4.
    \uD2B9\uD788 \uAC70\uB3D9\uC774 \uBD88\uD3B8\uD558\uAC70\uB098 \uC9C0\uC18D\uC801\uC778
    \uB3CC\uBD04\uC774 \uD544\uC694\uD55C \uACE0\uB839\uC790\uC5D0 \uB300\uD55C \uBCC4\uB3C4
    \uBCF4\uD638\uC2DC\uC124\uC740 \uB354\uC6B1 \uBD80\uC871\uD55C \uC0C1\uD669\uC774\uB2E4.\r\n\r\n\uD604\uC9C0
    \uAD00\uACC4\uC790\uB294 \u201C\uCD5C\uADFC \uAD6D\uACBD \uC8FC\uBCC0\uC5D0\uC11C
    \uAC00\uC871\uC744 \uCC3E\uAC70\uB098 \uBA38\uBB3C \uACF3\uC744 \uAD6C\uD558\uC9C0
    \uBABB\uD55C \uACE0\uB839\uC790\uB4E4\uC774 \uBC18\uBCF5\uC801\uC73C\uB85C \uBC1C\uACAC\uB418\uACE0
    \uC788\uB2E4\u201D\uBA70 \u201C\uB2E8\uC21C\uD788 \uAD6D\uACBD\uC5D0\uC11C \uB3CC\uB824\uBCF4\uB0B4\uB294
    \uAC83\uB9CC\uC73C\uB85C\uB294 \uBB38\uC81C\uB97C \uD574\uACB0\uD558\uAE30 \uC5B4\uB835\uB2E4\u201D\uACE0
    \uB9D0\uD588\uB2E4.\r\n\r\n\uD280\uB80C \uC815\uBD80\uB294 \uAD6D\uACBD \uC778\uADFC\uC5D0
    \uC784\uC2DC \uBCF4\uD638\uC2DC\uC124\uC744 \uCD94\uAC00\uB85C \uB9C8\uB828\uD558\uACE0,
    \uAC00\uC871\uACFC \uC5F0\uB77D\uC774 \uB04A\uAE34 \uACE0\uB839\uC790\uC758 \uC2E0\uC6D0
    \uD655\uC778\uACFC \uAC00\uC871 \uC7AC\uACB0\uD569\uC744 \uC9C0\uC6D0\uD558\uB294
    \uBC29\uC548\uC744 \uAC80\uD1A0\uD558\uACE0 \uC788\uB2E4. \uB610\uD55C \uC7A5\uAE30\uAC04
    \uAD6D\uACBD \uC8FC\uBCC0\uC5D0 \uBA38\uBB34\uB974\uB294 \uACE0\uB839 \uB09C\uBBFC\uC744
    \uBCC4\uB3C4\uB85C \uD30C\uC545\uD574 \uC758\uB8CC \uBC0F \uC0DD\uD65C \uC9C0\uC6D0\uC744
    \uC81C\uACF5\uD558\uB294 \uBC29\uC548\uB3C4 \uB17C\uC758 \uC911\uC774\uB2E4.\r\n\r\n\uC804\uBB38\uAC00\uB4E4\uC740
    \uC804\uC7C1\uACFC \uD53C\uB780\uC774 \uC7A5\uAE30\uD654\uB420\uC218\uB85D \uAC00\uC871\uACFC
    \uB5A8\uC5B4\uC838 \uD640\uB85C \uB0A8\uACA8\uC9C0\uB294 \uACE0\uB839 \uB09C\uBBFC\uC774
    \uC99D\uAC00\uD560 \uC218 \uC788\uB2E4\uBA70, \uC785\uAD6D \uC2EC\uC0AC\uC640
    \uBCC4\uAC1C\uB85C \uC774\uB4E4\uC744 \uBCF4\uD638\uD560 \uC218 \uC788\uB294
    \uC81C\uB3C4\uC801 \uB300\uCC45\uC774 \uD544\uC694\uD558\uB2E4\uACE0 \uC9C0\uC801\uD588\uB2E4."
