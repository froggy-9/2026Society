  useManualDecision: 1
  shouldApprove: 1
  decisionReason: "\uC704\uC870\uC5EC\uAD8C"
  dialogueLines:
  - "\uC7A0\uAE50\uB9CC\uC694."
  - "\uC65C \uACC4\uC18D \uC81C \uC5EC\uAD8C\uC744 \uBCF4\uC2DC\uACE0 \uACC4\uC18D
    \uB3CC\uB824\uBCF4\uB0B4\uC2DC\uB294 \uAC70\uC5D0\uC694?"
  - "\uC774\uAC70 \uC81C \uC5EC\uAD8C \uB9DE\uC544\uC694."
  - "\uC774\uAC8C \uC65C \uBB38\uC81C\uAC00 \uB418\uB294 \uAC74\uB370\uC694??"
  - "\uC800 \uC774\uAC70 \uADF8\uB0E5 \uBC1B\uC740 \uAC70 \uC544\uB2C8\uC5D0\uC694."
  - "\uB3C8 \uC8FC\uACE0 \uC815\uC2DD\uC73C\uB85C \uC0B0 \uAC70\uB77C\uAD6C\uC694!"
  - "\uC544\uBB34 \uBB38\uC81C \uC5C6\uC796\uC544\uC694."
  - "\uADF8\uB7EC\uB2C8\uAE4C \uBE68\uB9AC \uB4E4\uC5EC\uBCF4\uB0B4 \uC8FC\uC138\uC694."
  approvedFollowUpNews: "\n\n[ \uC18D\uBCF4 ]\n- \uCD5C\uADFC \uC704\uC870 \uC5EC\uAD8C
    \uC774\uC6A9\uD55C \uC785\uAD6D \uC0AC\uB840 \uC787\uB530\uB77C\u2026 \uB2F9\uAD6D,
    \uAC80\uBB38 \uAC15\uD654 \uBC29\uCE68\r\n\r\n\uCD5C\uADFC \uAD6D\uACBD\uC744
    \uD1B5\uD574 \uC704\uC870\uB41C \uC5EC\uAD8C\uC744 \uC774\uC6A9\uD574 \uC785\uAD6D\uD558\uB294
    \uC0AC\uB840\uAC00 \uC787\uB530\uB974\uBA74\uC11C \uB2F9\uAD6D\uC774 \uC870\uC0AC\uC5D0
    \uB098\uC130\uB2E4.\r\n\r\n\uAD00\uACC4 \uB2F9\uAD6D\uC5D0 \uB530\uB974\uBA74
    \uCD5C\uADFC \uC77C\uBD80 \uC785\uAD6D\uC790\uC5D0\uAC8C\uC11C \uC2E4\uC81C \uBC1C\uAE09
    \uAE30\uB85D\uACFC \uC77C\uCE58\uD558\uC9C0 \uC54A\uB294 \uC5EC\uAD8C\uC774 \uD655\uC778\uB410\uB2E4.
    \uD574\uB2F9 \uC5EC\uAD8C\uB4E4\uC740 \uC678\uAD00\uC0C1 \uC815\uC0C1\uC801\uC778
    \uC5EC\uAD8C\uACFC \uAD6C\uBCC4\uD558\uAE30 \uC5B4\uB824\uC6B4 \uACBD\uC6B0\uAC00
    \uC788\uC5B4 \uAC80\uBB38 \uACFC\uC815\uC5D0\uC11C \uBC1C\uACAC\uB418\uC9C0 \uC54A\uC740
    \uC0AC\uB840\uB3C4 \uC788\uB294 \uAC83\uC73C\uB85C \uC54C\uB824\uC84C\uB2E4.\r\n\r\n\uB2F9\uAD6D\uC740
    \uC704\uC870 \uC5EC\uAD8C\uC774 \uAD6D\uACBD\uC744 \uC911\uC2EC\uC73C\uB85C \uC870\uC9C1\uC801\uC73C\uB85C
    \uC720\uD1B5\uB418\uACE0 \uC788\uC744 \uAC00\uB2A5\uC131\uC5D0 \uC8FC\uBAA9\uD558\uACE0
    \uC788\uB2E4. \uD2B9\uD788 \uCD5C\uADFC \uB09C\uBBFC \uC720\uC785\uC774 \uAE09\uC99D\uD558\uBA74\uC11C
    \uC2E0\uC6D0 \uD655\uC778 \uC808\uCC28\uAC00 \uC9C0\uC5F0\uB418\uB294 \uD2C8\uC744
    \uC774\uC6A9\uD55C \uC0AC\uB840\uAC00 \uB298\uC5B4\uB09C \uAC83\uC73C\uB85C \uBCF4\uACE0
    \uC788\uB2E4.\r\n\r\n\uD55C \uAD00\uACC4\uC790\uB294 \u201C\uCD5C\uADFC \uC704\uC870
    \uC5EC\uAD8C\uACFC \uAD00\uB828\uB41C \uC0AC\uB840\uAC00 \uC9C0\uC18D\uC801\uC73C\uB85C
    \uD655\uC778\uB418\uACE0 \uC788\uB2E4\u201D\uBA70 \u201C\uC785\uAD6D\uC790\uC758
    \uC2E0\uC6D0\uACFC \uC5EC\uAD8C \uBC1C\uAE09 \uC815\uBCF4\uB97C \uB354\uC6B1
    \uBA74\uBC00\uD558\uAC8C \uD655\uC778\uD560 \uD544\uC694\uAC00 \uC788\uB2E4\u201D\uACE0
    \uBC1D\uD614\uB2E4.\r\n\r\n\uB2F9\uAD6D\uC740 \uC704\uC870 \uC5EC\uAD8C\uC758
    \uC720\uD1B5 \uACBD\uB85C\uC640 \uAD00\uB828 \uC870\uC9C1\uC744 \uC870\uC0AC\uD558\uB294
    \uD55C\uD3B8, \uAD6D\uACBD \uAC80\uBB38\uC18C\uC758 \uC11C\uB958 \uD655\uC778
    \uC808\uCC28\uB97C \uAC15\uD654\uD560 \uBC29\uCE68\uC774\uB2E4."
  rejectedFollowUpNews: "\n\n[ \uC18D\uBCF4 ]\n- \uC785\uAD6D \uD76C\uB9DD\uC790
    \uB300\uC0C1 \uC704\uC870 \uC5EC\uAD8C \uD310\uB9E4\u2026 \uBB34\uACE0\uD55C
    \uD53C\uD574\uC790 \uC18D\uCD9C\r\n\r\n\uCD5C\uADFC \uAD6D\uACBD\uC744 \uB118\uC73C\uB824\uB294
    \uC0AC\uB78C\uB4E4\uC744 \uB300\uC0C1\uC73C\uB85C \uD55C \uC704\uC870 \uC5EC\uAD8C
    \uC0AC\uAE30\uAC00 \uC787\uB530\uB974\uACE0 \uC788\uC5B4 \uC8FC\uC758\uAC00 \uC694\uAD6C\uB41C\uB2E4.\r\n\r\n\uAD00\uACC4
    \uB2F9\uAD6D\uC5D0 \uB530\uB974\uBA74 \uCD5C\uADFC \uB09C\uBBFC\uACFC \uC785\uAD6D
    \uD76C\uB9DD\uC790\uB4E4\uC5D0\uAC8C \uC815\uC0C1\uC801\uC73C\uB85C \uC0AC\uC6A9\uD560
    \uC218 \uC788\uB294 \uC5EC\uAD8C\uC774\uB77C\uACE0 \uC18D\uC5EC \uC704\uC870
    \uC5EC\uAD8C\uC744 \uD310\uB9E4\uD558\uB294 \uC0AC\uB840\uAC00 \uC5EC\uB7EC \uCC28\uB840
    \uD655\uC778\uB410\uB2E4.\r\n\r\n\uD53C\uD574\uC790\uB4E4\uC740 \uB300\uBD80\uBD84
    \uC5EC\uAD8C\uC774 \uC704\uC870\uB41C \uC0AC\uC2E4\uC744 \uC54C\uC9C0 \uBABB\uD55C
    \uCC44 \uC0C1\uB2F9\uD55C \uAE08\uC561\uC744 \uC9C0\uBD88\uD55C \uAC83\uC73C\uB85C
    \uC54C\uB824\uC84C\uB2E4. \uC77C\uBD80 \uD53C\uD574\uC790\uB294 \uAD6D\uACBD
    \uAC80\uBB38 \uACFC\uC815\uC5D0\uC11C \uCC98\uC74C\uC73C\uB85C \uC790\uC2E0\uC758
    \uC5EC\uAD8C\uC774 \uC704\uC870\uB410\uB2E4\uB294 \uC0AC\uC2E4\uC744 \uC54C\uAC8C
    \uB41C \uAC83\uC73C\uB85C \uC804\uD574\uC84C\uB2E4.\r\n\r\n\uB2F9\uAD6D\uC740
    \uD63C\uB780\uC2A4\uB7EC\uC6B4 \uC0C1\uD669\uACFC \uC2E0\uC6D0 \uD655\uC778\uC5D0
    \uC5B4\uB824\uC6C0\uC744 \uACAA\uB294 \uC0AC\uB78C\uB4E4\uC744 \uB178\uB9B0 \uC0AC\uAE30
    \uD589\uC704\uAC00 \uC99D\uAC00\uD558\uACE0 \uC788\uB294 \uAC83\uC73C\uB85C \uBCF4\uACE0
    \uC788\uB2E4.\r\n\r\n\uD55C \uAD00\uACC4\uC790\uB294 \u201C\uC704\uC870 \uC5EC\uAD8C\uC744
    \uC18C\uC9C0\uD558\uACE0 \uC788\uB2E4\uB294 \uC774\uC720\uB9CC\uC73C\uB85C \uD574\uB2F9
    \uC0AC\uC2E4\uC744 \uC54C\uACE0 \uC788\uC5C8\uB2E4\uACE0 \uB2E8\uC815\uD558\uAE30\uB294
    \uC5B4\uB835\uB2E4\u201D\uBA70 \u201C\uD53C\uD574\uC790\uAC00 \uB354 \uBC1C\uC0DD\uD558\uC9C0
    \uC54A\uB3C4\uB85D \uAD00\uB828 \uC218\uC0AC\uB97C \uD655\uB300\uD558\uACE0 \uC788\uB2E4\u201D\uACE0
    \uBC1D\uD614\uB2E4.\r\n\r\n\uB2F9\uAD6D\uC740 \uC704\uC870 \uC5EC\uAD8C\uC744
    \uC81C\uC791\xB7\uD310\uB9E4\uD55C \uC870\uC9C1\uC744 \uCD94\uC801\uD558\uB294
    \uD55C\uD3B8, \uD53C\uD574\uC790\uB4E4\uC758 \uD53C\uD574 \uACBD\uC704\uB97C
    \uD655\uC778\uD558\uACE0 \uC788\uB2E4\uACE0 \uC804\uD588\uB2E4."
