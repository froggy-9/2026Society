  decisionReason: Special NPC
  dialogueLines:
  - "\uC800\uAE30\uC694\u2026"
  - "\uC800 \uB4E4\uC5EC\uBCF4\uB0B4 \uC8FC\uC2DC\uBA74 \uC548 \uB3FC\uC694?"
  - "\uC800\u2026\u2026 \uC5EC\uAD8C\uC774 \uC5C6\uC5B4\uC694."
  - "\uC6D0\uB798\uB294 \uC788\uC5C8\uB294\uB370.."
  - "\u2026\u2026"
  - "\uC5C4\uB9C8\uAC00 \uAC00\uC9C0\uACE0 \uC788\uC744 \uAC70\uC5D0\uC694."
  - "\uADFC\uB370 \uC5C4\uB9C8\uAC00 \uC5B4\uB514\uC788\uB294\uC9C0 \uBAA8\uB974\uACA0\uC5B4\uC694.."
  - "\uCC3E\uC73C\uB824\uACE0 \uD588\uB294\uB370 \uBABB \uCC3E\uC558\uC5B4\uC694."
  - "\uADF8\uB798\uC11C \uADF8\uB0E5\u2026\u2026 \uACC4\uC18D \uC654\uC5B4\uC694."
  - "\uC5EC\uAE30 \uB4E4\uC5B4\uAC00\uBA74 \uB418\uB294 \uAC70\uC8E0?"
  - "\uC800 \uC548\uC5D0 \uB4E4\uC5B4\uAC00\uACE0 \uC2F6\uC5B4\uC694.\t"
  - "\uC800\u2026 \uBC16\uC5D0\uB294 \uBABB \uC788\uC5B4\uC694."
  - "\uC81C\uBC1C\uC694."
  approvedFollowUpNews: "\n\n[ \uC18D\uBCF4 ]\n- \uAD6D\uACBD \uD1B5\uACFC\uD55C
    \uC544\uB3D9 \uD1B5\uD574 \uC758\uC57D\uD488 \uBC18\uC785\u2026 \uAD00\uACC4
    \uB2F9\uAD6D \uC218\uC0AC \uCC29\uC218\r\n\r\n\uCD5C\uADFC \uAD6D\uACBD\uC744
    \uD1B5\uD574 \uBD88\uBC95 \uC758\uC57D\uD488\uC744 \uBC18\uC785\xB7\uC720\uD1B5\uD55C
    \uC870\uC9C1\uC758 \uC815\uD669\uC774 \uD655\uC778\uB3FC \uAD00\uACC4 \uB2F9\uAD6D\uC774
    \uC218\uC0AC\uC5D0 \uCC29\uC218\uD588\uB2E4.\r\n\r\n\uC218\uC0AC \uACB0\uACFC,
    \uD574\uB2F9 \uC870\uC9C1\uC740 \uC2E0\uC6D0\uC744 \uD655\uC778\uD558\uAE30 \uC5B4\uB824\uC6B4
    \uBBF8\uC131\uB144\uC790\uB97C \uC774\uC6A9\uD574 \uBD88\uBC95 \uC758\uC57D\uD488\uC744
    \uAD6D\uACBD \uC548\uC73C\uB85C \uBC18\uC785\uD55C \uAC83\uC73C\uB85C \uD30C\uC545\uB410\uB2E4.\r\n\r\n\uB2F9\uAD6D\uC740
    \uC774\uB4E4\uC774 \uB2E8\uC18D\uC744 \uD53C\uD558\uAE30 \uC704\uD574 \uC804\uC7C1
    \uB09C\uBBFC\uACFC \uBBF8\uC131\uB144\uC790 \uB4F1 \uC2E0\uBD84 \uD655\uC778\uC774
    \uC5B4\uB824\uC6B4 \uC0AC\uB78C\uB4E4\uC744 \uC774\uC6A9\uD55C \uAC83\uC73C\uB85C
    \uBCF4\uACE0 \uC788\uB2E4.\r\n\r\n\uC774\uBC88 \uC0AC\uAC74\uACFC \uAD00\uB828\uD574
    \uAD6D\uACBD \uAC80\uBB38 \uC808\uCC28\uAC00 \uC801\uC808\uD558\uAC8C \uC774\uB8E8\uC5B4\uC84C\uB294\uC9C0\uC5D0
    \uB300\uD55C \uC870\uC0AC\uB3C4 \uD568\uAED8 \uC9C4\uD589\uB418\uACE0 \uC788\uB2E4.\r\n\r\n\uB2F9\uAD6D
    \uAD00\uACC4\uC790\uB294\r\n\r\n\u201C\uBBF8\uC131\uB144\uC790\uAC00 \uBC94\uC8C4\uC5D0
    \uC774\uC6A9\uB41C \uC815\uD669\uC744 \uD655\uC778\uD588\uB2E4\u201D\uBA70\r\n\r\n\u201C\uC758\uC57D\uD488\uC758
    \uC720\uD1B5 \uACBD\uB85C\uC640 \uC870\uC9C1\uC758 \uADDC\uBAA8\uB97C \uD30C\uC545\uD558\uB294
    \uB370 \uC218\uC0AC\uB825\uC744 \uC9D1\uC911\uD558\uACE0 \uC788\uB2E4\u201D\uACE0
    \uBC1D\uD614\uB2E4.\r\n\r\n\uD604\uC7AC\uAE4C\uC9C0 \uBD88\uBC95 \uC758\uC57D\uD488\uC758
    \uC815\uD655\uD55C \uC720\uD1B5 \uADDC\uBAA8\uC640 \uAD00\uB828 \uC870\uC9C1\uC758
    \uC18C\uC7AC\uB294 \uD655\uC778\uB418\uC9C0 \uC54A\uC558\uB2E4."
  rejectedFollowUpNews: "\n\n[ \uC18D\uBCF4 ]\n- \uAD6D\uACBD \uC77C\uB300 \uBD88\uBC95
    \uC758\uC57D\uD488 \uC720\uD1B5\uB9DD \uD655\uC778\u2026 \uAD00\uACC4 \uB2F9\uAD6D,
    \uC870\uC9C1 \uCD94\uC801\r\n\r\n\uAD6D\uACBD \uC77C\uB300\uB97C \uC911\uC2EC\uC73C\uB85C
    \uBD88\uBC95 \uC758\uC57D\uD488\uC744 \uC720\uD1B5\uD574 \uC628 \uC870\uC9C1\uC5D0
    \uB300\uD55C \uC218\uC0AC\uAC00 \uD655\uB300\uB418\uACE0 \uC788\uB2E4.\r\n\r\n\uAD00\uACC4
    \uB2F9\uAD6D\uC740 \uD574\uB2F9 \uC870\uC9C1\uC774 \uCD5C\uADFC \uC218\uAC1C\uC6D4\uAC04
    \uBBF8\uC131\uB144\uC790\uC640 \uC2E0\uC6D0 \uD655\uC778\uC774 \uC5B4\uB824\uC6B4
    \uC0AC\uB78C\uB4E4\uC744 \uC774\uC6A9\uD574 \uBD88\uBC95 \uC758\uC57D\uD488\uC744
    \uAD6D\uACBD \uB108\uBA38\uB85C \uC6B4\uBC18\uD574 \uC628 \uC815\uD669\uC744
    \uD655\uC778\uD588\uB2E4\uACE0 \uBC1D\uD614\uB2E4.\r\n\r\n\uC218\uC0AC \uACFC\uC815\uC5D0\uC11C
    \uAD6D\uACBD \uC778\uADFC \uB300\uD53C\uC18C \uC8FC\uBCC0\uC5D0\uC11C \uC2E0\uC6D0\uBD88\uBA85\uC758
    \uC5EC\uC790\uC544\uC774 \uC2DC\uC2E0\uC774 \uBC1C\uACAC\uB410\uC73C\uBA70, \uB2F9\uAD6D\uC740
    \uD574\uB2F9 \uC0AC\uAC74 \uC5ED\uC2DC \uC870\uC9C1\uC758 \uD65C\uB3D9\uACFC
    \uAD00\uB828\uC774 \uC788\uC744 \uAC00\uB2A5\uC131\uC744 \uC870\uC0AC\uD558\uACE0
    \uC788\uB2E4.\r\n\r\n\uACBD\uCC30\uC740 \uC870\uC9C1\uC774 \uB2E8\uC18D\uC744
    \uD53C\uD558\uAE30 \uC704\uD574 \uCDE8\uC57D\uD55C \uC0AC\uB78C\uB4E4\uC744 \uC6B4\uBC18\uCC45\uC73C\uB85C
    \uC774\uC6A9\uD55C \uAC83\uC73C\uB85C \uBCF4\uACE0 \uC788\uC73C\uBA70, \uD604\uC7AC
    \uBD88\uBC95 \uC758\uC57D\uD488\uC758 \uC720\uD1B5 \uACBD\uB85C\uC640 \uC870\uC9C1\uC758
    \uADDC\uBAA8\uB97C \uD30C\uC545\uD558\uB294 \uB370 \uC218\uC0AC\uB825\uC744 \uC9D1\uC911\uD558\uACE0
    \uC788\uB2E4.\r\n\r\n\uB2F9\uAD6D \uAD00\uACC4\uC790\uB294 \u201C\uC870\uC9C1\uC774
    \uBBF8\uC131\uB144\uC790\uB97C \uBC94\uC8C4\uC5D0 \uC774\uC6A9\uD55C \uC815\uD669\uC744
    \uD655\uBCF4\uD588\uB2E4\u201D\uBA70 \uAD00\uB828\uC790\uB4E4\uC744 \uCD94\uC801\uD558\uB294
    \uD55C\uD3B8 \uCD94\uAC00 \uD53C\uD574 \uC5EC\uBD80\uB97C \uD655\uC778\uD558\uACE0
    \uC788\uB2E4\u201D\uACE0 \uBC1D\uD614\uB2E4.\r\n\r\n\uD55C\uD3B8 \uAD6D\uACBD
    \uC77C\uB300\uC5D0\uC11C \uC720\uC0AC\uD55C \uBC29\uC2DD\uC73C\uB85C \uBD88\uBC95
    \uC758\uC57D\uD488\uC774 \uC720\uD1B5\uB418\uACE0 \uC788\uB2E4\uB294 \uC81C\uBCF4\uAC00
    \uC787\uB530\uB974\uBA74\uC11C \uB2F9\uAD6D\uC740 \uAC80\uBB38 \uBC0F \uB2E8\uC18D\uC744
    \uAC15\uD654\uD560 \uBC29\uCE68\uC774\uB2E4."
