  m_Script: {fileID: 11500000, guid: 0d5b61d4199c8a346a376a1ef543e90b, type: 3}
  m_Name: Day3 News
  m_EditorClassIdentifier: Assembly-CSharp::NewsSO
  day: 3
  title: "\u25A0\u25A0\u25A0\uAD6D \uB0B4\uC804 \uC7A5\uAE30\uD654... \"\uC774\uC820
    \uC804\uC7C1\uBCF4\uB2E4 \uBC94\uC8C4\uAC00 \uB354 \uBB34\uC12D\uB2E4\""
  body: "\uB0B4\uC804\uC774 \uD574\uB97C \uB118\uAE30\uBA74\uC11C \u25A0\u25A0\u25A0\uAD6D
    \uB0B4 \uC808\uB3C4, \uB0A9\uCE58, \uC0B4\uC778, \uAC15\uB3C4 \uB4F1 \uAC15\uB825
    \uBC94\uC8C4\uAC00 \uD3ED\uC99D\uD558\uACE0 \uC788\uB2E4\uB294 \uC99D\uC5B8\uC774
    \uC774\uC5B4\uC9C0\uACE0 \uC788\uB2E4. \uD604\uC9C0 \uBC95\uB960 \uC804\uBB38\uAC00\uB294
    \"\uBE48\uACE4\uACFC \uC0DD\uACC4 \uBD95\uAD34\uB85C \uAC00\uC871\xB7\uACF5\uB3D9\uCCB4
    \uC720\uB300\uAC00 \uBB34\uB108\uC9C0\uBA74\uC11C, \uC608\uC804 \uAC19\uC73C\uBA74
    \uC0C1\uC0C1\uB3C4 \uBABB \uD560 \uBC94\uC8C4\uAC00 \uC77C\uC0C1\uC774 \uB410\uB2E4\"\uACE0
    \uC804\uD588\uB2E4.\r\n\r\n\uC774\uB7F0 \uC0C1\uD669\uC740 \uAD6D\uACBD \uAC80\uBB38\uC18C\uC758
    \uC2EC\uC0AC \uBD80\uB2F4\uC73C\uB85C \uC774\uC5B4\uC9C0\uACE0 \uC788\uB2E4.
    \uADF8\uB77C\uB2C8\uC544 \uC774\uBBFC\uCCAD\uC740 \"\uC804\uACFC \uAE30\uB85D\uC774
    \uD655\uC778\uB418\uC9C0 \uC54A\uAC70\uB098, \uC815\uC2E0\uACFC \uC9C4\uB8CC
    \uC774\uB825\uC774 \uC740\uD3D0\uB41C \uC785\uAD6D \uC2E0\uCCAD\uC790\uAC00 \uB298\uACE0
    \uC788\uB2E4\"\uBA70 \uC2E0\uC6D0 \uC870\uD68C\uB97C \uAC15\uD654\uD588\uB2E4.
    \uD2B9\uD788 \uCD5C\uADFC\uC5D0\uB294 \uC815\uAD50\uD558\uAC8C \uC704\uC870\uB41C
    \uC5EC\uAD8C\uACFC \uB3C4\uC7A5\uC744 \uC774\uC6A9\uD574 \uC2E0\uBD84\uC744 \uC138\uD0C1\uD558\uB824\uB294
    \uC2DC\uB3C4\uAC00 \uC787\uB530\uB77C \uC801\uBC1C\uB418\uACE0 \uC788\uB2E4.\r\n\r\n\uAD6D\uACBD
    \uC218\uBE44\uB300 \uAD00\uACC4\uC790\uB294 \"\uC704\uC870 \uC5EC\uAD8C \uD55C
    \uC7A5 \uB4A4\uC5D0\uB294 \uB300\uAC1C \uBC00\uC218 \uC870\uC9C1\uC774 \uC788\uB2E4.
    \uB2E8\uC21C\uD788 \uC11C\uB958 \uD55C \uC7A5\uC744 \uBCF4\uB294 \uAC8C \uC544\uB2C8\uB77C,
    \uADF8 \uB4A4\uC5D0 \uC228\uC740 \uC870\uC9C1\uC801 \uD750\uB984\uC744 \uBD10\uC57C
    \uD55C\uB2E4\"\uACE0 \uAC15\uC870\uD588\uB2E4."
