  m_Script: {fileID: 11500000, guid: 0d5b61d4199c8a346a376a1ef543e90b, type: 3}
  m_Name: Day1 News
  m_EditorClassIdentifier: Assembly-CSharp::NewsSO
  day: 1
  title: "\u25A0\u25A0\u25A0\uAD6D, \uC720\uD608 \uC815\uAD8C \uB2E4\uD23C\uC73C\uB85C
    \uB0B4\uC804 \uB3CC\uC785.. \uBA70\uCE60 \uC0C8 \uC218\uC2ED\uB9CC\uBA85 \uD53C\uB09C"
  body: "\u25A0\u25A0\u25A0\uAD6D\uC758 \uC218\uB3C4\uC5D0\uC11C \uC815\uBD80\uAD70\uACFC
    \uBC18\uAD70 \uAC04 \uBB34\uB825 \uCDA9\uB3CC\uC774 \uBC1C\uC0DD\uD55C \uC9C0
    \uD55C \uB2EC\uC5EC\uB9CC\uC5D0, \uAD6D\uACBD\uC744 \uB118\uB294 \uD53C\uB780\uBBFC
    \uD589\uB82C\uC774\r\n\u25CF\u25CF\uAD6D\uC758 \uC811\uACBD \uC9C0\uC5ED\uAE4C\uC9C0
    \uC774\uC5B4\uC9C0\uACE0 \uC788\uB2E4. \uD604\uC9C0 \uAD6C\uD638 \uB2E8\uCCB4\uB294
    \"\uCDA9\uB3CC \uBC1C\uC0DD \uCCAB \uB2EC\uC5D0\uB9CC 40\uB9CC \uBA85 \uC774\uC0C1\uC774
    \uC0B4\uB358 \uACF3\uC744 \uB5A0\uB0AC\uB2E4\"\uACE0 \uBC1D\uD614\uC73C\uBA70,
    \u25CF\u25CF\uAD6D \uC815\uBD80\uB294 \uC784\uC2DC \uC218\uC6A9\uC18C\uB97C \uAE09\uD788
    \uD655\uCDA9\uD558\uACE0 \uC788\uB2E4.\r\n\r\n\uAD6D\uACBD \uAC80\uBB38\uC18C\uC5D0\uB294
    \uC2E0\uC6D0\uC774 \uBA85\uD655\uD558\uC9C0 \uC54A\uC740 \uC785\uAD6D \uC2E0\uCCAD\uC790\uAC00
    \uB4A4\uC11E\uC5EC \uBAB0\uB824\uB4E4\uACE0 \uC788\uB2E4. \uB2F9\uAD6D\uC740
    \"\uC5EC\uAD8C \uC0AC\uC9C4\uACFC \uC2E4\uC81C \uC778\uBB3C\uC774 \uB2E4\uB974\uAC70\uB098,
    \uC5EC\uAD8C \uBC1C\uAE09 \uAD6D\uAC00 \uCF54\uB4DC\uAC00 \uC704\uC870\uB41C
    \uC0AC\uB840\uAC00 \uC774\uBBF8 \uB2E4\uC218 \uC801\uBC1C\uB410\uB2E4\"\uACE0
    \uC804\uD588\uB2E4. \u25CF\u25CF\uAD6D \uC774\uBBFC\uCCAD\uC740 \uAC80\uC0AC\uAD00\uB4E4\uC5D0\uAC8C
    \uC5EC\uAD8C \uCF54\uB4DC\uC640 \uC18C\uC9C0\uC790 \uC815\uBCF4\uC758 \uC77C\uCE58
    \uC5EC\uBD80, \uC5EC\uAD8C \uB9CC\uAD50\uC77C\uC744 \uBC18\uB4DC\uC2DC \uB300\uC870\uD560
    \uAC83\uC744 \uC9C0\uC2DC\uD588\uB2E4.\r\n\r\n\uD55C \uAD6C\uD638\uC694\uC6D0\uC740
    \"\uC804\uC7C1\uC774 \uD130\uC9C0\uBA74 \uCC98\uC74C \uBA70\uCE60\uC740 \uC815\uB9D0
    \uB3C4\uB9DD\uCCD0 \uB098\uC628 \uC0AC\uB78C\uB4E4\uC774 \uB300\uBD80\uBD84\uC774\uC9C0\uB9CC,
    \uC2DC\uAC04\uC774 \uC9C0\uB0A0\uC218\uB85D \uD63C\uB780\uC744 \uD2C8\uD0C0 \uB2E4\uB978
    \uBAA9\uC801\uC744 \uAC00\uC9C4 \uC0AC\uB78C\uB4E4\uB3C4 \uB4A4\uC11E\uC774\uAE30
    \uC2DC\uC791\uD55C\uB2E4\"\uACE0 \uC6B0\uB824\uD588\uB2E4."
  images:
  - {fileID: 0}
  image: {fileID: 0}
