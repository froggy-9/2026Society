  m_Script: {fileID: 11500000, guid: 0d5b61d4199c8a346a376a1ef543e90b, type: 3}
  m_Name: Day4 News
  m_EditorClassIdentifier: Assembly-CSharp::NewsSO
  day: 4
  title: "\uC218\uC6A9 \uD55C\uACC4 \uB118\uC5B4\uC120 \uAD6D\uACBD\u2026 \uD654\uC7AC\xB7\uC555\uC0AC
    \uC0AC\uACE0\uAE4C\uC9C0"
  body: "\uD53C\uB09C\uBBFC \uC218\uAC00 \uAC10\uB2F9 \uBC94\uC704\uB97C \uB118\uC5B4\uC11C\uBA74\uC11C
    \uC784\uC2DC \uC218\uC6A9\uC2DC\uC124 \uACF3\uACF3\uC5D0\uC11C \uD06C\uACE0 \uC791\uC740
    \uC0AC\uACE0\uAC00 \uC787\uB530\uB974\uACE0 \uC788\uB2E4. \uACFC\uBC00 \uC218\uC6A9\uC18C\uC5D0\uC11C\uB294
    \uCDE8\uC0AC\uC6A9 \uAC00\uC2A4\uD1B5 \uD3ED\uBC1C\uB85C \uCD94\uC815\uB418\uB294
    \uD654\uC7AC\uAC00 \uBC1C\uC0DD\uD574 \uC218\uCC9C \uBA85\uC774 \uD558\uB8FB\uBC24
    \uC0C8 \uAC70\uCC98\uB97C \uC783\uC5C8\uACE0, \uD63C\uB780 \uC18D\uC5D0 \uB300\uD53C\uD558\uB358
    \uC778\uD30C\uAC00 \uB4A4\uC5C9\uD0A4\uBA70 \uBD80\uC0C1\uC790\uAC00 \uC18D\uCD9C\uD588\uB2E4.\r\n\r\n\uAD6D\uACBD
    \uAC80\uBB38\uC18C \uC55E\uC5D0\uB294 \uBC24\uC0C8 \uB300\uAE30\uD558\uB358 \uC2E0\uCCAD\uC790\uB4E4\uC774
    \uD55C\uAEBC\uBC88\uC5D0 \uBAB0\uB9AC\uBA74\uC11C \uC555\uC0AC \uC704\uD5D8\uAE4C\uC9C0
    \uC81C\uAE30\uB418\uACE0 \uC788\uB2E4. \uD604\uC7A5 \uAD00\uACC4\uC790\uB294
    \"\uC9C0\uAE08\uC740 \uC11C\uB958\uB97C \uAF3C\uAF3C\uD788 \uBCFC \uC5EC\uC720\uC870\uCC28
    \uC5C6\uB2E4. \uADF8\uB7F0\uB370\uB3C4 \uC2E4\uC218 \uD558\uB098\uAC00 \uB204\uAD70\uAC00\uC758
    \uC0DD\uC0AC\uB97C \uAC00\uB97C \uC218 \uC788\uB2E4\uB294 \uAC8C \uB354 \uB450\uB835\uB2E4\"\uACE0
    \uB9D0\uD588\uB2E4.\r\n\r\n\uADF8\uB77C\uB2C8\uC544 \uC815\uBD80\uB294 \uAC80\uC0AC\uAD00\uB4E4\uC5D0\uAC8C
    \"\uD63C\uB780\uD55C \uC0C1\uD669\uC77C\uC218\uB85D \uC6D0\uCE59\uC744 \uC9C0\uCF1C\uC57C
    \uD55C\uB2E4\"\uBA70 \uC808\uCC28 \uC900\uC218\uB97C \uC7AC\uCC28 \uAC15\uC870\uD588\uB2E4."
