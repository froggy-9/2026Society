  m_Script: {fileID: 11500000, guid: 0d5b61d4199c8a346a376a1ef543e90b, type: 3}
  m_Name: Day4 News
  m_EditorClassIdentifier: Assembly-CSharp::NewsSO
  day: 4
  dateText: "\uBC1C\uD589\uC77C:  2050.06.20"
  dayText: "Day4_ \uC2E0\uBB38\uAE30\uC0AC"
  title: "\uD280\uB80C \uB0A8\uBD80 \uAD6D\uACBD \uB300\uAE30\uC2DC\uC124 \uD3EC\uD654\u2026\uC785\uAD6D\uC2EC\uC0AC
    \uC9C0\uC5F0 \uC18D\uCD9C"
  body: "\uC0AC\uB518\uC5D0\uC11C \uC815\uBD80\uAD70\uACFC \uBB34\uC7A5\uC138\uB825
    \uAC04 \uAD50\uC804\uC774 \uACA9\uD654\uD558\uBA74\uC11C \uC8FC\uBCC0\uAD6D\uC73C\uB85C
    \uD53C\uB780\uD558\uB294 \uC8FC\uBBFC\uC774 \uB298\uACE0 \uC788\uB2E4. \uCD5C\uADFC\uC5D0\uB294
    \uC778\uC811\uAD6D\uC744 \uAC70\uCCD0 \uD280\uB80C \uB0A8\uBD80 \uAD6D\uACBD\uC5D0
    \uB3C4\uCC29\uD558\uB294 \uC0AC\uB518 \uCD9C\uC2E0 \uD53C\uB780\uBBFC\uB3C4 \uC99D\uAC00\uD55C
    \uAC83\uC73C\uB85C \uB098\uD0C0\uB0AC\uB2E4.\r\n\r\n\uD280\uB80C \uB0B4\uBB34\uBD80\uB294
    5\uC77C \"\uB0A8\uBD80 \uAD6D\uACBD\uC744 \uD1B5\uD55C \uC785\uAD6D \uC2E0\uCCAD\uC774
    \uAE09\uC99D\uD558\uBA74\uC11C \uC77C\uBD80 \uAC80\uBB38\uC18C\uC758 \uB300\uAE30
    \uC778\uC6D0\uC774 \uC218\uC6A9 \uAC00\uB2A5 \uBC94\uC704\uB97C \uC774\uBBF8
    \uB118\uC5B4\uC130\uB2E4\"\uACE0 \uBC1D\uD614\uB2E4. \uC170\uB9AC\uC544\xB7\uCE74\uBD88\uB780
    \uCD9C\uC2E0 \uC785\uAD6D\uC790\uAC00 \uAFB8\uC900\uD788 \uC774\uC5B4\uC9C0\uB294
    \uAC00\uC6B4\uB370 \uC0AC\uB518 \uCD9C\uC2E0\uAE4C\uC9C0 \uB298\uBA74\uC11C \uAE30\uC874
    \uC778\uB825\uACFC \uC2DC\uC124\uB85C\uB294 \uAC10\uB2F9\uD558\uAE30 \uC5B4\uB824\uC6B4
    \uC218\uC900\uC5D0 \uC774\uB974\uB800\uB2E4\uB294 \uC124\uBA85\uC774\uB2E4.\r\n\r\n\uD280\uB80C\uC740
    \uC9C0\uB09C \uC218\uB144\uAC04 \uB300\uADDC\uBAA8 \uB09C\uBBFC\uC744 \uC218\uC6A9\uD574\uC624\uBA74\uC11C
    \uC218\uC6A9\uC2DC\uC124 \uC6B4\uC601 \uC608\uC0B0\uACFC \uC2EC\uC0AC \uC778\uB825\uC774
    \uC774\uBBF8 \uD55C\uACC4\uC5D0 \uB2E4\uB2E4\uB978 \uC0C1\uD0DC\uC600\uB2E4.
    \uD280\uB80C \uC9C0\uBC29\uC815\uBD80\uC758 \uD55C \uAD00\uACC4\uC790\uB294 \"\uAD6D\uC81C\uC0AC\uD68C
    \uC9C0\uC6D0\uC774 \uD655\uB300\uB418\uC9C0 \uC54A\uB294 \uD55C \uC790\uCCB4
    \uC608\uC0B0\uB9CC\uC73C\uB85C \uC2DC\uC124\uC744 \uCD94\uAC00\uB85C \uB298\uB9AC\uAE30\uB294
    \uC5B4\uB835\uB2E4\"\uACE0 \uB9D0\uD588\uB2E4.\r\n\r\n\uC77C\uBD80 \uAC80\uBB38\uC18C\uC5D0\uC11C\uB294
    \uB2F9\uC77C \uC811\uC218\uB41C \uC2E0\uCCAD\uC744 \uBAA8\uB450 \uCC98\uB9AC\uD558\uC9C0
    \uBABB\uD574 \uB300\uAE30 \uC778\uC6D0\uC774 \uB2E4\uC74C \uB0A0\uAE4C\uC9C0
    \uC774\uC6D4\uB418\uB294 \uACBD\uC6B0\uB3C4 \uBC1C\uC0DD\uD588\uB2E4. \uD280\uB80C
    \uB2F9\uAD6D\uC740 \uAC80\uBB38\uC18C \uC778\uADFC\uC5D0 \uC784\uC2DC \uB300\uAE30\uC2DC\uC124\uC744
    \uB9C8\uB828\uD558\uACE0 \uB2E4\uB978 \uC9C0\uC5ED\uC5D0\uC11C \uADFC\uBB34\uD558\uB358
    \uCD9C\uC785\uAD6D \uC2EC\uC0AC \uC778\uB825\uC744 \uB0A8\uBD80 \uAD6D\uACBD\uC5D0
    \uCD94\uAC00 \uBC30\uCE58\uD588\uB2E4."
