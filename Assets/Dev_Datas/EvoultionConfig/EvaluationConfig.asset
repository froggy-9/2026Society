  endingNews:
  - endingType: 0
    metaText: "\uC5D4\uB529\uBD84\uAE30\uC810: \uC6D0\uCE59_  \uC874\uC18D"
    headline: "\uC138\uACC4 \uB09C\uBBFC\uC758 \uB0A0\uC5D0\uB3C4 \uC774\uC5B4\uC9C4
      \uAD6D\uACBD \uD589\uB82C\u2026\uC815\uBD80, \uD604\uD589 \uC2EC\uC0AC\uCCB4\uACC4
      \uC720\uC9C0"
    body: "\uC138\uACC4 \uB09C\uBBFC\uC758 \uB0A0\uC778 20\uC77C, \uC815\uBD80\uB294
      \uCD5C\uADFC \uC99D\uAC00\uD55C \uBCF4\uD638 \uC2E0\uCCAD\uC5D0\uB3C4 \uD604\uD589
      \uAD6D\uACBD \uC2EC\uC0AC\uCCB4\uACC4\uB97C \uC720\uC9C0\uD558\uACA0\uB2E4\uACE0
      \uBC1D\uD614\uB2E4.\n\n\uAD6D\uACBD\uAD00\uB9AC\uAD6D\uC5D0 \uB530\uB974\uBA74
      \uC8FC\uC694 \uAC80\uBB38\uC18C\uC758 \uC785\uAD6D \uC2EC\uC0AC\uB294 \uD604\uC7AC
      \uC815\uC0C1\uC801\uC73C\uB85C \uC6B4\uC601\uB418\uACE0 \uC788\uB2E4. \uBCF4\uD638
      \uB300\uC0C1\uC73C\uB85C \uC778\uC815\uB41C \uC785\uAD6D\uC790\uB4E4\uC740
      \uC784\uC2DC\uAC70\uC8FC\uC2DC\uC124\uC744 \uAC70\uCCD0 \uC9C0\uC5ED\uBCC4
      \uC815\uCC29 \uC808\uCC28\uC5D0 \uB4E4\uC5B4\uAC14\uC73C\uBA70, \uAD00\uACC4\uAE30\uAD00\uC740
      \uC2E0\uC6D0 \uD655\uC778\uACFC \uCCB4\uB958 \uC2EC\uC0AC\uB3C4 \uAE30\uC874
      \uAE30\uC900\uC5D0 \uB530\uB77C \uACC4\uC18D \uC9C4\uD589\uD560 \uC608\uC815\uC774\uB2E4.\n\n\uAD6D\uB0B4\uC5D0
      \uC815\uCC29\uD55C \uB09C\uBBFC\uC744 \uB458\uB7EC\uC2FC \uACFC\uC81C\uB294
      \uB0A8\uC544 \uC788\uB2E4. \uC77C\uBD80 \uC9C0\uBC29\uC815\uBD80\uB294 \uC8FC\uAC70\uC640
      \uAD50\uC721, \uCDE8\uC5C5 \uC9C0\uC6D0\uC744 \uC704\uD55C \uCD94\uAC00 \uC608\uC0B0\uC744
      \uC694\uCCAD\uD588\uACE0, \uC7A5\uAE30 \uCCB4\uB958\uC790\uAC00 \uB9CE\uC740
      \uC784\uC2DC\uAC70\uC8FC\uC2DC\uC124\uC5D0\uC11C\uB294 \uC218\uC6A9 \uACF5\uAC04
      \uBD80\uC871\uB3C4 \uC774\uC5B4\uC9C0\uACE0 \uC788\uB2E4.\n\n\uAD6D\uACBD \uBC16
      \uC0C1\uD669\uB3C4 \uD06C\uAC8C \uB2EC\uB77C\uC9C0\uC9C0 \uC54A\uC558\uB2E4.
      \uC8FC\uBCC0 \uC9C0\uC5ED\uC758 \uBD88\uC548\uC815\uD55C \uC815\uC138\uAC00
      \uACC4\uC18D\uB418\uBA74\uC11C \uC774\uB0A0\uB3C4 \uBCF4\uD638\uB97C \uC694\uCCAD\uD558\uB294
      \uC0AC\uB78C\uB4E4\uC774 \uAC80\uBB38\uC18C\uB97C \uCC3E\uC558\uB2E4. \uB2F9\uAD6D\uC740
      \uD5A5\uD6C4 \uC720\uC785 \uADDC\uBAA8\uAC00 \uB2E4\uC2DC \uC99D\uAC00\uD560
      \uAC00\uB2A5\uC131\uC5D0 \uB300\uBE44\uD574 \uD604\uC7AC \uC778\uB825\uACFC
      \uC2DC\uC124\uC744 \uC720\uC9C0\uD558\uAE30\uB85C \uD588\uB2E4.\n\n\uC815\uBD80\uB294
      \uC774\uB0A0 \uC138\uACC4 \uB09C\uBBFC\uC758 \uB0A0\uC744 \uB9DE\uC544 \uBCF4\uD638
      \uB300\uC0C1\uC790\uC758 \uC815\uCC29 \uC9C0\uC6D0\uC744 \uD655\uB300\uD558\uACA0\uB2E4\uACE0
      \uBC1D\uD614\uB2E4.\n\n\uAD6D\uACBD \uAC80\uBB38\uC18C\uC758 \uC2EC\uC0AC\uB294
      21\uC77C\uC5D0\uB3C4 \uC608\uC815\uB300\uB85C \uACC4\uC18D\uB41C\uB2E4."
    images: []
  - endingType: 1
    metaText: "\uC5D4\uB529\uBD84\uAE30\uC810: \uC778\uB3C4\uC8FC\uC758_  \uC0AC\uD6C4\uAD00\uB9AC"
    headline: "\uAD6D\uACBD\uC11C \uB3CC\uC544\uC120 \uB09C\uBBFC\uB4E4 \uC778\uC811\uAD6D\uC5D0
      \uC7A5\uAE30 \uCCB4\uB958\u2026\uC815\uBD80, \uBCF4\uD638 \uB300\uC0C1 \uC7AC\uD655\uC778
      \uCC29\uC218"
    body: "\uC138\uACC4 \uB09C\uBBFC\uC758 \uB0A0\uC778 20\uC77C, \uC815\uBD80\uAC00
      \uCD5C\uADFC \uAD6D\uACBD\uC744 \uD1B5\uACFC\uD558\uC9C0 \uBABB\uD55C \uCC44
      \uC778\uC811\uAD6D\uACFC \uC811\uACBD\uC9C0\uC5ED\uC5D0 \uBA38\uBB3C\uACE0
      \uC788\uB294 \uB09C\uBBFC\uB4E4\uC744 \uB300\uC0C1\uC73C\uB85C \uBCF4\uD638
      \uD544\uC694\uC131\uC744 \uB2E4\uC2DC \uD655\uC778\uD558\uAE30\uB85C \uD588\uB2E4.\n\n\uC778\uC811\uAD6D
      \uB2F9\uAD6D\uACFC \uAD6D\uC81C\uAD6C\uD638\uB2E8\uCCB4\uC5D0 \uB530\uB974\uBA74
      \uCD5C\uADFC \uC218\uAC1C\uC6D4\uAC04 \uAD6D\uACBD \uC778\uADFC \uC784\uC2DC\uC2DC\uC124\uACFC
      \uBE44\uACF5\uC2DD \uAC70\uC8FC\uC9C0\uC5D0 \uBA38\uBB34\uB974\uB294 \uB09C\uBBFC\uC774
      \uB298\uBA74\uC11C \uC77C\uBD80 \uC9C0\uC5ED\uC758 \uC218\uC6A9 \uC5EC\uB825\uC774
      \uD55C\uACC4\uC5D0 \uAC00\uAE4C\uC6CC\uC9C0\uACE0 \uC788\uB2E4. \uC774\uB4E4
      \uAC00\uC6B4\uB370\uB294 \uC5EC\uB7EC \uCC28\uB840 \uC785\uAD6D\uC744 \uC2DC\uB3C4\uD55C
      \uB4A4 \uC811\uACBD\uC9C0\uC5ED\uC5D0 \uB0A8\uAC70\uB098 \uBCF8\uAD6D\uC73C\uB85C
      \uB3CC\uC544\uAC04 \uC0AC\uB78C\uB4E4\uB3C4 \uD3EC\uD568\uB41C \uAC83\uC73C\uB85C
      \uC54C\uB824\uC84C\uB2E4.\n\n\uBB38\uC81C\uB294 \uC774 \uACFC\uC815\uC5D0\uC11C
      \uAC00\uC871\uC744 \uB3D9\uBC18\uD55C \uC0AC\uB78C\uACFC \uBBF8\uC131\uB144\uC790,
      \uBCF8\uAD6D\uC73C\uB85C \uB3CC\uC544\uAC00\uAE30 \uC5B4\uB824\uC6B4 \uC0AC\uC815\uC774
      \uC788\uB294 \uC0AC\uB78C\uB4E4\uB3C4 \uC0C1\uB2F9 \uAE30\uAC04 \uBCF4\uD638
      \uC808\uCC28\uC5D0 \uC5F0\uACB0\uB418\uC9C0 \uBABB\uD588\uB2E4\uB294 \uC810\uC774\uB2E4.\n\n\uCD5C\uADFC
      \uAD00\uACC4\uAE30\uAD00\uC774 \uC778\uC811\uAD6D\uC758 \uC694\uCCAD\uC744
      \uBC1B\uC544 \uC77C\uBD80 \uC0AC\uB840\uB97C \uD655\uC778\uD558\uB294 \uACFC\uC815\uC5D0\uC11C\uB294
      \uC774\uC804\uC5D0 \uAD6D\uACBD\uC5D0\uC11C \uC785\uAD6D \uC808\uCC28\uAC00
      \uC885\uB8CC\uB41C \uC0AC\uB78C \uAC00\uC6B4\uB370 \uCD94\uAC00\uC801\uC778
      \uBCF4\uD638 \uAC80\uD1A0\uAC00 \uD544\uC694\uD55C \uC0AC\uB840\uB3C4 \uD655\uC778\uB410\uB2E4.
      \uC815\uBD80\uB294 \uB2F9\uC2DC \uC801\uC6A9\uB41C \uAC1C\uBCC4 \uD310\uB2E8\uC758
      \uC801\uC815\uC131\uC744 \uC77C\uAD04\uC801\uC73C\uB85C \uC7AC\uAC80\uD1A0\uD558\uB294
      \uB2E8\uACC4\uB294 \uC544\uB2C8\uB77C\uBA74\uC11C\uB3C4, \uC7A5\uAE30\uAC04
      \uC811\uACBD\uC9C0\uC5ED\uC5D0 \uBA38\uBB34\uB974\uB294 \uC0AC\uB78C\uB4E4\uC758
      \uC0C1\uD669\uC744 \uBCC4\uB3C4\uB85C \uD655\uC778\uD560 \uD544\uC694\uAC00
      \uC788\uB2E4\uACE0 \uC124\uBA85\uD588\uB2E4.\n\n\uC778\uC811\uAD6D \uC815\uBD80\uB294
      \uC790\uAD6D\uC758 \uC784\uC2DC\uC2DC\uC124\uB9CC\uC73C\uB85C \uD604\uC7AC
      \uC778\uC6D0\uC744 \uC7A5\uAE30\uAC04 \uC218\uC6A9\uD558\uAE30 \uC5B4\uB835\uB2E4\uBA70
      \uC6B0\uB9AC \uC815\uBD80\uC640 \uAD6D\uC81C\uAE30\uAD6C\uC5D0 \uC778\uB825\uACFC
      \uC7AC\uC815 \uC9C0\uC6D0\uC744 \uC694\uCCAD\uD588\uB2E4. \uAD6D\uC81C\uAD6C\uD638\uB2E8\uCCB4\uB4E4\uB3C4
      \uAD6D\uACBD\uC744 \uD1B5\uACFC\uD558\uC9C0 \uBABB\uD55C \uC0AC\uB78C\uC774
      \uC778\uC811\uAD6D\uC5D0 \uACC4\uC18D \uBA38\uBB34\uB974\uB294 \uBC29\uC2DD\uB9CC\uC73C\uB85C\uB294
      \uBB38\uC81C\uB97C \uD574\uACB0\uD558\uAE30 \uC5B4\uB835\uB2E4\uACE0 \uC9C0\uC801\uD558\uACE0
      \uC788\uB2E4.\n\n\uC815\uBD80\uB294 \uC6B0\uC120 \uBBF8\uC131\uB144\uC790\uC640
      \uAC00\uC871 \uB2E8\uC704 \uCCB4\uB958\uC790, \uADC0\uD658\uC774 \uC5B4\uB824\uC6B4
      \uC0AC\uB78C\uC744 \uC911\uC2EC\uC73C\uB85C \uBCF4\uD638 \uD544\uC694\uC131\uC744
      \uD655\uC778\uD558\uACE0 \uD544\uC694\uD55C \uACBD\uC6B0 \uBCC4\uB3C4\uC758
      \uC808\uCC28\uB97C \uC81C\uACF5\uD560 \uBC29\uCE68\uC774\uB2E4.\n\n\uC138\uACC4
      \uB09C\uBBFC\uC758 \uB0A0\uC744 \uB9DE\uC544 \uC608\uC815\uB410\uB358 \uC815\uBD80
      \uD589\uC0AC\uC5D0\uC11C\uB3C4 \uAD6D\uB0B4 \uC815\uCC29 \uC9C0\uC6D0\uACFC
      \uD568\uAED8 \uC811\uACBD\uC9C0\uC5ED \uC7A5\uAE30 \uCCB4\uB958 \uBB38\uC81C\uAC00
      \uC8FC\uC694 \uC758\uC81C\uB85C \uB2E4\uB904\uC84C\uB2E4.\n\n\uC815\uBD80\uB294
      \uC778\uC811\uAD6D \uBC0F \uAD6D\uC81C\uAE30\uAD6C\uC640 \uD611\uC758\uB97C
      \uAC70\uCCD0 \uD655\uC778\uB41C \uC0AC\uB840\uC5D0 \uB300\uD55C \uD6C4\uC18D
      \uC870\uCE58\uB97C \uC21C\uCC28\uC801\uC73C\uB85C \uC9C4\uD589\uD560 \uC608\uC815\uC774\uB2E4."
    images: []
  - endingType: 2
    metaText: "\uC5D4\uB529\uBD84\uAE30\uC810: \uBD84\uC5F4_  \uD3D0\uC1C4\uC870\uCE58"
    headline: "\uC787\uB2E8 \uC2E0\uC6D0 \uD655\uC778 \uBB38\uC81C\uC5D0 \uB09C\uBBFC\uC815\uCC45
      \uAC08\uB4F1 \uD655\uC0B0\u2026\uC815\uBD80, \uAD6D\uACBD \uC2EC\uC0AC \uC7A0\uC815
      \uC911\uB2E8"
    body: "\uC138\uACC4 \uB09C\uBBFC\uC758 \uB0A0\uC778 20\uC77C, \uC815\uBD80\uAC00
      \uC8FC\uC694 \uAD6D\uACBD \uAC80\uBB38\uC18C\uC758 \uC2E0\uADDC \uC785\uAD6D
      \uC2EC\uC0AC\uB97C \uC7A0\uC815 \uC911\uB2E8\uD558\uACE0 \uCD5C\uADFC \uC785\uAD6D\uC790\uC5D0
      \uB300\uD55C \uC2E0\uC6D0 \uD655\uC778\uACFC \uBCF4\uD638\xB7\uAD00\uB9AC \uCCB4\uACC4\uB97C
      \uC804\uBA74 \uC810\uAC80\uD558\uAE30\uB85C \uD588\uB2E4.\n\n\uCD5C\uADFC \uC11C\uB85C
      \uB2E4\uB978 \uC9C0\uC5ED\uC5D0\uC11C \uBC1C\uC0DD\uD55C \uC0AC\uAC74\uC744
      \uC870\uC0AC\uD558\uB294 \uACFC\uC815\uC5D0\uC11C \uC77C\uBD80 \uC785\uAD6D\uC790\uC758
      \uC2E4\uC81C \uC2E0\uC6D0\uC774\uB098 \uACFC\uAC70 \uAE30\uB85D\uC774 \uC785\uAD6D
      \uB2F9\uC2DC \uD655\uBCF4\uB41C \uC815\uBCF4\uC640 \uC77C\uCE58\uD558\uC9C0
      \uC54A\uB294 \uC0AC\uB840\uAC00 \uC787\uB530\uB77C \uD655\uC778\uB41C \uB370
      \uB530\uB978 \uAC83\uC774\uB2E4.\n\n\uACBD\uCC30\uC740 \uCD5C\uADFC \uBC1C\uC0DD\uD55C
      \uD3ED\uD589\uACFC \uC808\uB3C4 \uC0AC\uAC74\uC758 \uD53C\uC758\uC790 \uAC00\uC6B4\uB370
      \uC785\uAD6D \uB2F9\uC2DC \uC2E0\uC6D0 \uD655\uC778\uC774 \uCDA9\uBD84\uD558\uC9C0
      \uC54A\uC558\uB358 \uC0AC\uB840\uB97C \uD655\uC778\uD588\uB2E4\uACE0 \uBC1D\uD614\uB2E4.
      \uBCC4\uB3C4\uC758 \uC9C0\uC5ED\uC5D0\uC11C\uB294 \uC9C0\uC18D\uC801\uC778
      \uBCF4\uD638\uC640 \uCE58\uB8CC\uAC00 \uD544\uC694\uD55C \uC0C1\uD0DC\uB85C
      \uC785\uAD6D\uD588\uC9C0\uB9CC \uAD00\uB828 \uAE30\uAD00\uC5D0 \uC5F0\uACB0\uB418\uC9C0
      \uC54A\uC740 \uCC44 \uC0DD\uD65C\uD574 \uC628 \uC0AC\uB78C\uC774 \uBC1C\uACAC\uB3FC
      \uC9C0\uBC29\uC815\uBD80\uAC00 \uAE34\uAE09 \uBCF4\uD638\uC5D0 \uB098\uC130\uB2E4.\n\n\uB2F9\uAD6D\uC740
      \uD604\uC7AC\uAE4C\uC9C0 \uD655\uC778\uB41C \uC0AC\uB840\uB4E4\uC774 \uC11C\uB85C
      \uC9C1\uC811\uC801\uC73C\uB85C \uC5F0\uAD00\uB3FC \uC788\uB2E4\uB294 \uC99D\uAC70\uB294
      \uC5C6\uB2E4\uACE0 \uBC1D\uD614\uB2E4. \uB2E4\uB9CC \uCD5C\uADFC \uC785\uAD6D\uC790
      \uAC00\uC6B4\uB370 \uC2E0\uC6D0\uC774\uB098 \uBCF4\uD638 \uD544\uC694\uC131\uC774
      \uCDA9\uBD84\uD788 \uD655\uC778\uB418\uC9C0 \uC54A\uC740 \uC0AC\uB840\uAC00
      \uCD94\uAC00\uB85C \uC874\uC7AC\uD560 \uAC00\uB2A5\uC131\uC744 \uBC30\uC81C\uD558\uC9C0
      \uC54A\uACE0 \uAD00\uB828 \uC790\uB8CC\uB97C \uB2E4\uC2DC \uD655\uC778\uD558\uACE0
      \uC788\uB2E4.\n\n\uAC1C\uBCC4 \uC0AC\uAC74\uC73C\uB85C \uC2DC\uC791\uB41C \uB17C\uB780\uC740
      \uB09C\uBBFC \uC218\uC6A9\uC815\uCC45 \uC804\uBC18\uC73C\uB85C \uBC88\uC84C\uB2E4.\n\n\uC77C\uBD80
      \uC9C0\uC5ED\uC5D0\uC11C\uB294 \uC2E0\uADDC \uC218\uC6A9 \uC911\uB2E8\uACFC
      \uAD6D\uACBD \uC2EC\uC0AC \uAC15\uD654\uB97C \uC694\uAD6C\uD558\uB294 \uC9D1\uD68C\uAC00
      \uC5F4\uB838\uACE0, \uBC18\uB300\uD3B8\uC5D0\uC11C\uB294 \uC77C\uBD80 \uC0AC\uAC74\uC744
      \uC774\uC720\uB85C \uB09C\uBBFC \uC804\uCCB4\uB97C \uC704\uD5D8 \uC9D1\uB2E8\uC73C\uB85C
      \uCDE8\uAE09\uD574\uC11C\uB294 \uC548 \uB41C\uB2E4\uB294 \uC9D1\uD68C\uAC00
      \uC774\uC5B4\uC84C\uB2E4. \uB09C\uBBFC \uC784\uC2DC\uAC70\uC8FC\uC2DC\uC124
      \uC124\uCE58\uB97C \uCD94\uC9C4\uD558\uB358 \uC77C\uBD80 \uC9C0\uBC29\uC815\uBD80\uB3C4
      \uC8FC\uBBFC \uBC18\uBC1C\uC774 \uCEE4\uC9C0\uC790 \uACC4\uD68D\uC744 \uC7A0\uC815
      \uBCF4\uB958\uD588\uB2E4.\n\n\uC138\uACC4 \uB09C\uBBFC\uC758 \uB0A0\uC778 \uC774\uB0A0
      \uB3C4\uC2EC\uC5D0\uC11C \uC5F4\uB9B0 \uC591\uCE21 \uC9D1\uD68C\uC5D0\uC11C\uB294
      \uCC38\uAC00\uC790 \uC0AC\uC774\uC758 \uCDA9\uB3CC\uB85C \uACBD\uCC30\uC774
      \uD604\uC7A5\uC744 \uD1B5\uC81C\uD588\uB2E4. \uC608\uC815\uB410\uB358 \uC77C\uBD80
      \uAE30\uB150\uD589\uC0AC\uB3C4 \uC548\uC804 \uBB38\uC81C\uB85C \uCD95\uC18C\uB410\uB2E4.\n\n\uC815\uBD80\uB294
      \uAE30\uC874 \uBCF4\uD638 \uB300\uC0C1\uC790\uC5D0 \uB300\uD55C \uC9C0\uC6D0\uC740
      \uACC4\uC18D\uD558\uB418 \uC2E0\uC6D0 \uD655\uC778\uACFC \uC785\uAD6D \uC2EC\uC0AC
      \uC808\uCC28\uC5D0 \uB300\uD55C \uC810\uAC80\uC774 \uB05D\uB0A0 \uB54C\uAE4C\uC9C0
      \uC2E0\uADDC \uC785\uAD6D \uC5C5\uBB34\uB97C \uC911\uB2E8\uD558\uAE30\uB85C
      \uD588\uB2E4.\n\n\uAD6D\uACBD\uAD00\uB9AC\uAD6D\uC740 \uC774\uB0A0 \uC624\uD6C4
      \uC8FC\uC694 \uAC80\uBB38\uC18C \uC6B4\uC601\uC744 \uC911\uB2E8\uD588\uB2E4.
      \uC7AC\uAC1C \uC2DC\uC810\uC740 \uC815\uD574\uC9C0\uC9C0 \uC54A\uC558\uB2E4."
