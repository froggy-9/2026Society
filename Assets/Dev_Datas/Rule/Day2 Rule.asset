  m_Script: {fileID: 11500000, guid: c5e4ee7df97f32241bc8ccd461a11b4d, type: 3}
  m_Name: Day2 Rule
  m_EditorClassIdentifier: Assembly-CSharp::RuleSO
  ruleID: 2
  ruleName: Day2
  description: "[\uAE30\uBCF8 \uC2EC\uC0AC \uC0AC\uD56D]\r\n\r\n1. \uC5EC\uAD8C,
    \uC785\uAD6D \uC2E0\uACE0\uC11C \uC81C\uCD9C \uD655\uC778\r\n\uC5EC\uAD8C\uACFC
    \uC785\uAD6D \uC2E0\uACE0\uC11C\uB97C \uBAA8\uB450 \uC81C\uCD9C\uD574\uC57C \uD558\uBA70,
    \uB458 \uC911 \uD558\uB098\uB77C\uB3C4 \uC81C\uCD9C\uD558\uC9C0 \uC54A\uC744
    \uACBD\uC6B0 \uC785\uAD6D\uC744 \uBD88\uD5C8\uD55C\uB2E4.\r\n\r\n2. \uBCF8\uC778
    \uD655\uC778\r\n\uC785\uAD6D \uC2E0\uCCAD\uC790\uC758 \uC5BC\uAD74\uACFC \uC5EC\uAD8C\uC5D0
    \uBD80\uCC29\uB41C \uC0AC\uC9C4\uC744 \uB300\uC870\uD55C\uB2E4.\r\n\uBCF8\uC778\uC73C\uB85C
    \uD655\uC778\uB418\uC9C0 \uC54A\uC744 \uACBD\uC6B0 \uC785\uAD6D\uC744 \uBD88\uD5C8\uD55C\uB2E4.\r\n\r\n3.
    \uC5EC\uAD8C\uACFC \uC785\uAD6D \uC2E0\uACE0\uC11C \uC77C\uCE58 \uD655\uC778\r\n\uC5EC\uAD8C\uACFC
    \uC785\uAD6D \uC2E0\uACE0\uC11C\uC758 \uB370\uC774\uD130\uAC00 \uC77C\uCE58\uD558\uC9C0
    \uC54A\uC744 \uACBD\uC6B0 \uC785\uAD6D\uC744 \uBD88\uD5C8\uD55C\uB2E4.\r\n\r\n4.
    \uC5EC\uAD8C \uC720\uD6A8\uAE30\uAC04 \uD655\uC778\r\n\uC5EC\uAD8C\uC5D0 \uAE30\uC7AC\uB41C
    \uB9CC\uB8CC\uC77C\uC744 \uD655\uC778\uD55C\uB2E4.\r\n\uC2EC\uC0AC\uC77C\uC744
    \uAE30\uC900\uC73C\uB85C \uC720\uD6A8\uAE30\uAC04\uC774 \uC9C0\uB09C \uC5EC\uAD8C\uC740
    \uC778\uC815\uD558\uC9C0 \uC54A\uB294\uB2E4.\n\n\n[\uAE08\uC77C \uCD94\uAC00
    \uC0AC\uD56D]\n\n1. \uCD9C\uC2E0 \uAD6D\uAC00 \uD655\uC778\n\uC785\uAD6D \uC81C\uD55C
    \uAD6D\uAC00 \u2014 \uC170\uB9AC\uC544\n\n2. \uC9C1\uC5C5 \uD655\uC778\n\uD655\uC778
    \uB300\uC0C1 \u2014 \uC758\uC0AC / \uC57D\uC0AC / \uC758\uC57D\uD488 \uC720\uD1B5\uC5C5
    \uC885\uC0AC\uC790"
